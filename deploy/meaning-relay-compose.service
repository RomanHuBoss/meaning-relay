[Unit]
Description=Meaning Relay Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/www-root/data/www/meaning.web-line.ru
ExecStart=/usr/local/sbin/meaning-relay-compose up -d
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
