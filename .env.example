NODE_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://postgres:password@localhost:5432/meaning_relay
DATABASE_SSL=disable
DB_POOL_MAX=10
SID_PEPPER=replace-with-at-least-32-random-bytes
ADMIN_KEY=replace-with-a-long-random-admin-key
CRON_SECRET=replace-with-a-long-random-cron-secret
MAINTENANCE_TIMEOUT_MS=15000
PUBLIC_BASE_URL=https://meaning.web-line.ru
PRIVACY_OPERATOR_NAME=Смысловой телефон
PRIVACY_CONTACT_EMAIL=design@web-line.ru
MODERATION_CONTACT_EMAIL=design@web-line.ru
MAP_ENABLED=true
APP_PORT=3001
CLAIM_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
